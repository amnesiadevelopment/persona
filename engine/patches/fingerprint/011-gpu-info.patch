diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
new file mode 100644
index 0000000000..75a4117ddad8fb82998b561d120f65f48d74f6d5
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
@@ -0,0 +1,174 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_fingerprint.h"
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/fingerprint_data.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "third_party/blink/renderer/modules/webgl/gpu_info.h"
+
+// GPU deviceID信息可以在这里查询
+// 570.144是驱动号，替换成最新的驱动号
+// https://download.nvidia.com/XFree86/Linux-x86_64/570.144/README/supportedchips.html
+// https://deviceandbrowserinfo.com/data/fingerprints/attribute/webGLRenderer
+// https://devicehunt.com/view/type/pci/vendor/10DE
+
+namespace blink {
+
+using ungoogled::fingerprint::kMacosGpuModelCount;
+
+namespace {
+
+// Returns the appropriate GL_VENDOR string based on platform
+std::string GetGLVendorString(const std::string& platform) {
+  if (platform == "macos") {
+    return "Google Inc. (Apple)";
+  } else if (platform == "linux") {
+    return "Google Inc. (NVIDIA Corporation)";
+  } else {
+    // Windows
+    return "Google Inc. (NVIDIA)";
+  }
+}
+
+// Returns a GL_RENDERER string based on platform and fingerprint
+std::string GetGLRendererString(const std::string& platform, uint32_t fingerprint) {
+  if (platform == "macos") {
+    // Use helper function to get macOS GPU string
+    return GetMacosGpuString(fingerprint % kMacosGpuModelCount);
+  } else if (platform == "linux") {
+    // For Linux, get the basic GPU model but format for Linux
+    size_t model_index = fingerprint % GetGpuCount();
+    // Get the Windows GPU info to extract the model name
+    const GpuInfo& gpu_info = GetGpuInfo(model_index);
+    // Format for Linux (no device ID, different suffix)
+    return GetLinuxGpuString(gpu_info.model_name);
+  } else {
+    // Default to Windows format
+    return GetGpuInfo(fingerprint % GetGpuCount()).renderer_string;
+  }
+}
+
+// The declared platform for this fingerprint, lower-cased. Windows is the
+// default when --fingerprint-platform is absent, matching how the identity
+// spoofs below resolve it.
+std::string GetDeclaredPlatform() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kFingerprintPlatform)) {
+    return base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(switches::kFingerprintPlatform));
+  }
+  return "windows";
+}
+
+// True when the engine is fingerprinting the GPU: --fingerprint is set and
+// disable-spoofing does not include "gpu".
+bool IsGpuFingerprintActive() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  // 如果 disable-spoofing 包含 gpu，不应用指纹
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("gpu") != std::string::npos) {
+    return false;
+  }
+  return command_line->HasSwitch(switches::kFingerprint);
+}
+
+// Capability limits are overridden ONLY on the windows arm — the one claimed
+// platform we hold a measured reference for (PS-440: a real RTX 3060 on D3D11
+// ANGLE, same engine build). The linux arm claims an NVIDIA desktop-GL card
+// and the macos arm claims Apple silicon; no real reference table was
+// measured for either, and inventing values would trade the SwiftShader
+// contradiction for a fabricated one. Those arms keep the host's real limits.
+bool IsWindowsGpuFingerprintActive() {
+  return IsGpuFingerprintActive() && GetDeclaredPlatform() == "windows";
+}
+
+// ─── The claimed card's capability limits (PS-440) ───
+//
+// Measured side by side against a real RTX 3060 on D3D11 ANGLE, same engine
+// build. These are the values every card in the claimed pool answers on that
+// backend — they are ANGLE's Direct3D11 feature-level-11 constants, not
+// per-card. SwiftShader, which actually renders on the Linux dev VM, answers
+// 8192/4096/32-class values that contradict the claimed card on every one of
+// them, and hands out a cube-map limit above its 2D texture limit, which no
+// real driver does.
+//
+// PAGE-VISIBLE ONLY: these feed getParameter() answers. The backend's real
+// limits stay authoritative for GL itself — a page that believes the claimed
+// card and asks for a 16384 texture gets the backend's own error, exactly as
+// it would from a real driver refusing the request.
+
+constexpr int32_t kSpoofedMaxTextureSize = 16384;            // GL_MAX_TEXTURE_SIZE (0x0D33)
+constexpr int32_t kSpoofedMaxRenderbufferSize = 16384;       // GL_MAX_RENDERBUFFER_SIZE (0x84E8)
+constexpr int32_t kSpoofedMaxCubeMapTextureSize = 16384;     // GL_MAX_CUBE_MAP_TEXTURE_SIZE (0x851C)
+constexpr int32_t kSpoofedMaxVertexUniformVectors = 4095;    // GL_MAX_VERTEX_UNIFORM_VECTORS (0x8DFB)
+constexpr int32_t kSpoofedMaxFragmentUniformVectors = 1024;  // GL_MAX_FRAGMENT_UNIFORM_VECTORS (0x8DFD)
+constexpr int32_t kSpoofedMaxVaryingVectors = 30;            // GL_MAX_VARYING_VECTORS (0x8DFC)
+constexpr int32_t kSpoofedMaxTextureImageUnits = 16;         // GL_MAX_TEXTURE_IMAGE_UNITS (0x8872)
+constexpr int32_t kSpoofedMaxVertexTextureImageUnits = 16;   // GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS (0x8B4C)
+
+constexpr int32_t kSpoofedMaxViewportDims[2] = {32767, 32767};  // GL_MAX_VIEWPORT_DIMS (0x0D3A)
+constexpr float kSpoofedPointSizeRange[2] = {1.0f, 1024.0f};    // GL_ALIASED_POINT_SIZE_RANGE (0x846D)
+
+}  // namespace
+
+// Public functions that will be used in WebGL code
+std::string GetGLVendorStringForFingerprint() {
+  if (!IsGpuFingerprintActive()) {
+    return "";
+  }
+  return GetGLVendorString(GetDeclaredPlatform());
+}
+
+std::string GetGLRendererStringForFingerprint() {
+  if (!IsGpuFingerprintActive()) {
+    return "";
+  }
+  std::string fingerprint_str =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(switches::kFingerprint);
+  uint32_t fingerprint = 0;
+  base::StringToUint(fingerprint_str, &fingerprint);
+  return GetGLRendererString(GetDeclaredPlatform(), fingerprint);
+}
+
+std::optional<int32_t> GetSpoofedIntLimitForFingerprint(uint32_t pname) {
+  if (!IsWindowsGpuFingerprintActive()) {
+    return std::nullopt;
+  }
+  switch (pname) {
+    case 0x0D33:  // GL_MAX_TEXTURE_SIZE
+      return kSpoofedMaxTextureSize;
+    case 0x84E8:  // GL_MAX_RENDERBUFFER_SIZE
+      return kSpoofedMaxRenderbufferSize;
+    case 0x851C:  // GL_MAX_CUBE_MAP_TEXTURE_SIZE
+      return kSpoofedMaxCubeMapTextureSize;
+    case 0x8DFB:  // GL_MAX_VERTEX_UNIFORM_VECTORS
+      return kSpoofedMaxVertexUniformVectors;
+    case 0x8DFD:  // GL_MAX_FRAGMENT_UNIFORM_VECTORS
+      return kSpoofedMaxFragmentUniformVectors;
+    case 0x8DFC:  // GL_MAX_VARYING_VECTORS
+      return kSpoofedMaxVaryingVectors;
+    case 0x8872:  // GL_MAX_TEXTURE_IMAGE_UNITS
+      return kSpoofedMaxTextureImageUnits;
+    case 0x8B4C:  // GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS
+      return kSpoofedMaxVertexTextureImageUnits;
+    default:
+      return std::nullopt;
+  }
+}
+
+std::optional<std::array<int32_t, 2>> GetSpoofedViewportDimsForFingerprint() {
+  if (!IsWindowsGpuFingerprintActive()) {
+    return std::nullopt;
+  }
+  return std::array<int32_t, 2>{kSpoofedMaxViewportDims[0], kSpoofedMaxViewportDims[1]};
+}
+
+std::optional<std::array<float, 2>> GetSpoofedPointSizeRangeForFingerprint() {
+  if (!IsWindowsGpuFingerprintActive()) {
+    return std::nullopt;
+  }
+  return std::array<float, 2>{kSpoofedPointSizeRange[0], kSpoofedPointSizeRange[1]};
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h
