diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
new file mode 100644
index 0000000000..c9951800bdd394894fbb812365933659338a3121
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
@@ -0,0 +1,235 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_fingerprint.h"
+
+#include <algorithm>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/fingerprint_data.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "third_party/blink/renderer/modules/webgl/gpu_info.h"
+
+// GPU deviceID信息可以在这里查询
+// 570.144是驱动号，替换成最新的驱动号
+// https://download.nvidia.com/XFree86/Linux-x86_64/570.144/README/supportedchips.html
+// https://deviceandbrowserinfo.com/data/fingerprints/attribute/webGLRenderer
+// https://devicehunt.com/view/type/pci/vendor/10DE
+
+namespace blink {
+
+using ungoogled::fingerprint::kMacosGpuModelCount;
+
+namespace {
+
+// Returns the appropriate GL_VENDOR string based on platform
+std::string GetGLVendorString(const std::string& platform) {
+  if (platform == "macos") {
+    return "Google Inc. (Apple)";
+  } else if (platform == "linux") {
+    return "Google Inc. (NVIDIA Corporation)";
+  } else {
+    // Windows
+    return "Google Inc. (NVIDIA)";
+  }
+}
+
+// Returns a GL_RENDERER string based on platform and fingerprint
+std::string GetGLRendererString(const std::string& platform, uint32_t fingerprint) {
+  if (platform == "macos") {
+    // Use helper function to get macOS GPU string
+    return GetMacosGpuString(fingerprint % kMacosGpuModelCount);
+  } else if (platform == "linux") {
+    // For Linux, get the basic GPU model but format for Linux
+    size_t model_index = fingerprint % GetGpuCount();
+    // Get the Windows GPU info to extract the model name
+    const GpuInfo& gpu_info = GetGpuInfo(model_index);
+    // Format for Linux (no device ID, different suffix)
+    return GetLinuxGpuString(gpu_info.model_name);
+  } else {
+    // Default to Windows format
+    return GetGpuInfo(fingerprint % GetGpuCount()).renderer_string;
+  }
+}
+
+// The declared platform for this fingerprint, lower-cased. Windows is the
+// default when --fingerprint-platform is absent, matching how the identity
+// spoofs below resolve it.
+std::string GetDeclaredPlatform() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kFingerprintPlatform)) {
+    return base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(switches::kFingerprintPlatform));
+  }
+  return "windows";
+}
+
+// True when the engine is fingerprinting the GPU: --fingerprint is set and
+// disable-spoofing does not include "gpu".
+bool IsGpuFingerprintActive() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  // 如果 disable-spoofing 包含 gpu，不应用指纹
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("gpu") != std::string::npos) {
+    return false;
+  }
+  return command_line->HasSwitch(switches::kFingerprint);
+}
+
+// Capability limits are overridden ONLY on the windows arm — the one claimed
+// platform we hold a measured reference for (PS-440: a real RTX 3060 on D3D11
+// ANGLE, same engine build). The linux arm claims an NVIDIA desktop-GL card
+// and the macos arm claims Apple silicon; no real reference table was
+// measured for either, and inventing values would trade the SwiftShader
+// contradiction for a fabricated one. Those arms keep the host's real limits.
+bool IsWindowsGpuFingerprintActive() {
+  return IsGpuFingerprintActive() && GetDeclaredPlatform() == "windows";
+}
+
+// ─── The claimed card's capability limits (PS-440) ───
+//
+// Measured side by side against a real RTX 3060 on D3D11 ANGLE, same engine
+// build. These are the values every card in the claimed pool answers on that
+// backend — they are ANGLE's Direct3D11 feature-level-11 constants, not
+// per-card. SwiftShader, which actually renders on the Linux dev VM, answers
+// 8192/4096/32-class values that contradict the claimed card on almost every
+// one of them, and hands out a cube-map limit ABOVE its own 2D texture limit,
+// which no real driver does.
+//
+// ⚠️ WE NEVER REPORT ABOVE WHAT THE BACKEND CAN ACTUALLY DO.
+//
+// Every getter below takes the backend's real answer and returns
+// min(claimed, real) — a DOWNWARD lie only. That is not caution, it is the
+// difference between a spoof a checker must compare against a reference card
+// and one it can catch from our own context alone. Blink's internal
+// validation keeps reading the real backend limits (max_texture_size_ off
+// ContextGL is untouched), so an UPWARD claim is not merely cosmetic.
+// Measured on SwiftShader under persona's own Linux flags
+// (--use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader),
+// reading the limit and then allocating at it:
+//
+//   texImage2D(..., 16384, 16384, ...)       -> GL_INVALID_VALUE
+//   renderbufferStorage(..., 16384, 16384)   -> GL_INVALID_VALUE
+//   viewport(0, 0, 32767, 32767)             -> no error, READS BACK 8192
+//
+// The viewport case is the worst of the three: it fails silently, so a page
+// that advertises 32767, sets exactly that, and reads back 8192 has caught us
+// with no reference card and no error to check. That is the same
+// self-contained-impossibility class as the cube-map pair this patch removes,
+// so claiming upward would trade one such tell for three.
+//
+// THE CLAMP IS A NO-OP WHERE THE CLAIM IS TRUE. On a real D3D11 backend the
+// measured answers ARE 16384/32767, so min(claimed, real) is the claim and
+// the windows arm is unaffected. It bites only where the backend cannot back
+// the claim, which means it degrades correctly by platform without having to
+// know which backend it is running on — and it stays correct by itself if
+// Linux later gets a real GPU (PS-445).
+
+constexpr int32_t kClaimedMaxTextureSize = 16384;            // GL_MAX_TEXTURE_SIZE (0x0D33)
+constexpr int32_t kClaimedMaxRenderbufferSize = 16384;       // GL_MAX_RENDERBUFFER_SIZE (0x84E8)
+constexpr int32_t kClaimedMaxCubeMapTextureSize = 16384;     // GL_MAX_CUBE_MAP_TEXTURE_SIZE (0x851C)
+constexpr int32_t kClaimedMaxVertexUniformVectors = 4095;    // GL_MAX_VERTEX_UNIFORM_VECTORS (0x8DFB)
+constexpr int32_t kClaimedMaxFragmentUniformVectors = 1024;  // GL_MAX_FRAGMENT_UNIFORM_VECTORS (0x8DFD)
+constexpr int32_t kClaimedMaxVaryingVectors = 30;            // GL_MAX_VARYING_VECTORS (0x8DFC)
+constexpr int32_t kClaimedMaxTextureImageUnits = 16;         // GL_MAX_TEXTURE_IMAGE_UNITS (0x8872)
+constexpr int32_t kClaimedMaxVertexTextureImageUnits = 16;   // GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS (0x8B4C)
+
+constexpr int32_t kClaimedMaxViewportDims[2] = {32767, 32767};  // GL_MAX_VIEWPORT_DIMS (0x0D3A)
+constexpr float kClaimedPointSizeRange[2] = {1.0f, 1024.0f};    // GL_ALIASED_POINT_SIZE_RANGE (0x846D)
+
+// The value we would LIKE to claim for a pname, before clamping. nullopt for
+// a pname this patch does not claim at all, which is how the call site knows
+// to fall through untouched.
+std::optional<int32_t> ClaimedIntLimit(uint32_t pname) {
+  switch (pname) {
+    case 0x0D33:  // GL_MAX_TEXTURE_SIZE
+      return kClaimedMaxTextureSize;
+    case 0x84E8:  // GL_MAX_RENDERBUFFER_SIZE
+      return kClaimedMaxRenderbufferSize;
+    case 0x851C:  // GL_MAX_CUBE_MAP_TEXTURE_SIZE
+      return kClaimedMaxCubeMapTextureSize;
+    case 0x8DFB:  // GL_MAX_VERTEX_UNIFORM_VECTORS
+      return kClaimedMaxVertexUniformVectors;
+    case 0x8DFD:  // GL_MAX_FRAGMENT_UNIFORM_VECTORS
+      return kClaimedMaxFragmentUniformVectors;
+    case 0x8DFC:  // GL_MAX_VARYING_VECTORS
+      return kClaimedMaxVaryingVectors;
+    case 0x8872:  // GL_MAX_TEXTURE_IMAGE_UNITS
+      return kClaimedMaxTextureImageUnits;
+    case 0x8B4C:  // GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS
+      return kClaimedMaxVertexTextureImageUnits;
+    default:
+      return std::nullopt;
+  }
+}
+
+}  // namespace
+
+// Public functions that will be used in WebGL code
+std::string GetGLVendorStringForFingerprint() {
+  if (!IsGpuFingerprintActive()) {
+    return "";
+  }
+  return GetGLVendorString(GetDeclaredPlatform());
+}
+
+std::string GetGLRendererStringForFingerprint() {
+  if (!IsGpuFingerprintActive()) {
+    return "";
+  }
+  std::string fingerprint_str =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(switches::kFingerprint);
+  uint32_t fingerprint = 0;
+  base::StringToUint(fingerprint_str, &fingerprint);
+  return GetGLRendererString(GetDeclaredPlatform(), fingerprint);
+}
+
+int32_t GetSpoofedIntLimitForFingerprint(uint32_t pname,
+                                         int32_t real_value,
+                                         int32_t reported_max_texture_size) {
+  if (!IsWindowsGpuFingerprintActive()) {
+    return real_value;
+  }
+  std::optional<int32_t> claimed = ClaimedIntLimit(pname);
+  if (!claimed.has_value()) {
+    return real_value;
+  }
+  // Downward only — never advertise a capability the backend will refuse.
+  int32_t answer = std::min(*claimed, real_value);
+
+  // The cube-map limit is additionally capped by the 2D texture size we
+  // REPORT, not merely by its own backend value. SwiftShader answers 16384
+  // here beside a real 8192 texture limit, so clamping cube against its own
+  // backend value alone would leave the impossible pair fully intact: no
+  // driver hands out a cube map larger than its 2D texture limit, and that
+  // is the one contradiction a checker can catch from our own two numbers
+  // with no reference card at all.
+  if (pname == 0x851C) {  // GL_MAX_CUBE_MAP_TEXTURE_SIZE
+    answer = std::min(answer, reported_max_texture_size);
+  }
+  return answer;
+}
+
+std::array<int32_t, 2> GetSpoofedViewportDimsForFingerprint(
+    const std::array<int32_t, 2>& real_dims) {
+  if (!IsWindowsGpuFingerprintActive()) {
+    return real_dims;
+  }
+  return std::array<int32_t, 2>{
+      std::min(kClaimedMaxViewportDims[0], real_dims[0]),
+      std::min(kClaimedMaxViewportDims[1], real_dims[1])};
+}
+
+std::array<float, 2> GetSpoofedPointSizeRangeForFingerprint(
+    const std::array<float, 2>& real_range) {
+  if (!IsWindowsGpuFingerprintActive()) {
+    return real_range;
+  }
+  // The LOW end is a floor, not a ceiling: claiming a smaller minimum point
+  // size than the backend supports would be the same upward lie in the other
+  // direction, so it is clamped upward to the backend's own minimum.
+  return std::array<float, 2>{
+      std::max(kClaimedPointSizeRange[0], real_range[0]),
+      std::min(kClaimedPointSizeRange[1], real_range[1])};
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h
new file mode 100644
index 0000000000..e5262820a56b8f80fc4ced3093722e6b6f210613
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h
@@ -0,0 +1,50 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace blink {
+
+// Returns the GL_VENDOR string based on platform and fingerprint
+std::string GetGLVendorStringForFingerprint();
+
+// Returns the GL_RENDERER string based on platform and fingerprint
+std::string GetGLRendererStringForFingerprint();
+
+// Page-visible capability-limit overrides for the card the fingerprint
+// CLAIMS (PS-440). When the engine claims an NVIDIA GeForce RTX answered by
+// ANGLE on Direct3D11 (the windows platform arm), getParameter() should
+// answer that card's limits: the host backend's limits (SwiftShader on the
+// Linux dev VM) contradict the claimed renderer string, and SwiftShader's
+// cube-map limit above its 2D texture limit contradicts itself.
+//
+// ⚠️ EACH GETTER TAKES THE BACKEND'S REAL ANSWER AND RETURNS min(claimed,
+// real) — never more than the backend can actually do. An upward claim is
+// not cosmetic: Blink's internal validation still reads the real backend
+// limit, so a page that believes it is handed GL_INVALID_VALUE on allocation
+// (measured), or — for the viewport — silently reads back the real value it
+// was just told was smaller. Both are catchable with no reference card,
+// which is strictly worse than the numeric mismatch they would fix.
+//
+// The clamp is a no-op where the claim is true: on a real D3D11 backend the
+// measured answers ARE the claimed ones. Each getter returns the real value
+// unchanged when no override applies (gpu spoofing off, or the declared
+// platform is not windows), so the call site can use the result directly.
+//
+// `reported_max_texture_size` is the value the caller is ALREADY reporting
+// for GL_MAX_TEXTURE_SIZE. The cube-map limit is capped against it so the
+// pair can never come back impossible.
+int32_t GetSpoofedIntLimitForFingerprint(uint32_t pname,
+                                         int32_t real_value,
+                                         int32_t reported_max_texture_size);
+std::array<int32_t, 2> GetSpoofedViewportDimsForFingerprint(
+    const std::array<int32_t, 2>& real_dims);
+std::array<float, 2> GetSpoofedPointSizeRangeForFingerprint(
+    const std::array<float, 2>& real_range);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
diff --git a/third_party/blink/renderer/modules/webgl/gpu_info.cc b/third_party/blink/renderer/modules/webgl/gpu_info.cc
new file mode 100644
index 0000000000..eac0857e23
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_info.cc
@@ -0,0 +1,100 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_info.h"
+
+#include "base/strings/stringprintf.h"
+#include "components/ungoogled/fingerprint_data.h"
+
+namespace blink {
+
+using ungoogled::fingerprint::GpuModelInfo;
+using ungoogled::fingerprint::kGpuModelCount;
+using ungoogled::fingerprint::kGpuModels;
+using ungoogled::fingerprint::kLinuxGpuSuffix;
+using ungoogled::fingerprint::kLinuxVendorString;
+using ungoogled::fingerprint::kMacosGpuModelCount;
+using ungoogled::fingerprint::kMacosGpuModels;
+using ungoogled::fingerprint::kWindowsGpuSuffix;
+using ungoogled::fingerprint::kWindowsVendorString;
+
+// Generate full Windows GPU info on demand
+GpuInfo GetWindowsGpuInfo(size_t index) {
+  if (index >= kGpuModelCount) {
+    // Default to last one (RTX 4090) if out of bounds
+    index = kGpuModelCount - 1;
+  }
+
+  const GpuModelInfo& model = kGpuModels[index];
+  GpuInfo info;
+  info.model_name = model.model_name;
+  info.device_id = model.device_id;
+
+  // Build the Windows renderer string
+  std::string device_id_part = (model.device_id && model.device_id[0]) ?
+    " (" + std::string(model.device_id) + ")" : "";
+
+  info.renderer_string = "ANGLE (" + std::string(kWindowsVendorString) +
+                         ", NVIDIA " + info.model_name +
+                         device_id_part + " " + kWindowsGpuSuffix + ")";
+
+  return info;
+}
+
+// All Windows GPU info list - generated from kGpuModels
+std::vector<GpuInfo> GetAllWindowsGpuInfo() {
+  std::vector<GpuInfo> result;
+  result.reserve(kGpuModelCount);
+
+  for (size_t i = 0; i < kGpuModelCount; ++i) {
+    result.push_back(GetWindowsGpuInfo(i));
+  }
+
+  return result;
+}
+
+// Lazy-initialized list of Windows GPU info
+const std::vector<GpuInfo>& GetWindowsGpuInfoList() {
+  static const std::vector<GpuInfo>* windows_gpu_info = nullptr;
+  if (!windows_gpu_info) {
+    windows_gpu_info = new std::vector<GpuInfo>(GetAllWindowsGpuInfo());
+  }
+  return *windows_gpu_info;
+}
+
+// Implementation of the functions declared in the header
+size_t GetGpuCount() {
+  return kGpuModelCount;
+}
+
+const GpuInfo& GetGpuInfo(size_t index) {
+  // Use the Windows GPU info list
+  const std::vector<GpuInfo>& windows_list = GetWindowsGpuInfoList();
+
+  // Ensure index is in bounds
+  if (index >= windows_list.size()) {
+    return windows_list.back();
+  }
+
+  return windows_list[index];
+}
+
+// Helper function to get a macOS GPU model string
+std::string GetMacosGpuString(size_t index) {
+  if (index >= kMacosGpuModelCount) {
+    // Default to M3 if out of bounds
+    index = kMacosGpuModelCount - 1;  // Index of M3 in the array
+  }
+
+  return base::StringPrintf("ANGLE (Apple, ANGLE Metal Renderer: Apple %s, Unspecified Version)",
+                         kMacosGpuModels[index]);
+}
+
+// Helper function to get a Linux GPU renderer string
+std::string GetLinuxGpuString(const std::string& model_name) {
+  // Note the difference: no device ID and no space before /PCIe
+  // Also using the Linux-specific vendor string
+  return base::StringPrintf("ANGLE (%s, NVIDIA %s%s)",
